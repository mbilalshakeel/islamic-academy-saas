# ═══════════════════════════════════════════════════════════════
# Environment variables for the ICI Multi-Tenant Platform
# ───────────────────────────────────────────────────────────────
# Copy this file to `.env.local` for local dev, or set the matching
# keys in your production host's environment (e.g. Vercel Project →
# Settings → Environment Variables). All values below are the LOCAL
# dev placeholders — replace with production values before deploying.
# ═══════════════════════════════════════════════════════════════

# Supabase project URL. Local dev = http://127.0.0.1:54321
# Production = https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase anon/public key (JWT, role=anon). Safe to expose client-side.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# The root domain of the platform, used for tenant subdomains.
# Production = e.g. iciapp.com  →  <tenant-slug>.iciapp.com
NEXT_PUBLIC_APP_BASE_DOMAIN=iciapp.com

# Supabase service_role key (SECRET — server-side only, NEVER in client code).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Shared secret for the scheduled hard-delete cron endpoint.
# Production = generate a long random value.
CRON_SECRET=local-dev-cron-secret-change-in-prod

# JWT secret used by Supabase to sign tokens. MUST match the Supabase
# project's JWT secret (Settings → API → JWT Secret). Used server-side
# only (minting scoped anon JWTs). Production = your project's JWT secret.
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
